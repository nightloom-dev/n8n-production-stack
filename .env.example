# where n8n lives. a public name gets a Let's Encrypt cert (open ports 80 and 443 and publish them
# as 80 and 443), localhost gets a cert from Caddy's own CA
SITE_ADDRESS=localhost
PUBLIC_URL=https://localhost:8443
HTTPS_PUBLISH=127.0.0.1:8443
HTTP_PUBLISH=127.0.0.1:8080

# Grafana, Prometheus and Alertmanager listen on this machine only, use an SSH tunnel
GRAFANA_PUBLISH=127.0.0.1:3000
PROMETHEUS_PUBLISH=127.0.0.1:9090
ALERTMANAGER_PUBLISH=127.0.0.1:9093

TZ=UTC
WORKER_CONCURRENCY=10

# nightly backup at BACKUP_AT (time zone TZ) into a restic repo, by default a volume on this machine
# offsite: RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/n8n plus the two keys
BACKUP_AT=03:00
RESTIC_REPOSITORY=/repo
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# alerts go to this Telegram chat, bot token is in secrets/telegram_bot_token. until both are real
# alerts don't get sent (Alertmanager logs why). 0 doesn't work as a chat id
TELEGRAM_CHAT_ID=-1
TELEGRAM_API_URL=https://api.telegram.org
